{
  "productName": "La Compania",
  "mainBinaryName": "la-compania",
  "version": "0.1.0",
  "identifier": "org.lacompania.algoritmos",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "La Compañía",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Algoritmos de bioinformática",
    "longDescription": "Algoritmos de bioinformática en Rust con explicaciones y datos de E. coli incluidos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
